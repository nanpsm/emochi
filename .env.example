# Generate with: npx auth secret
AUTH_SECRET=

# From your Microsoft Entra ID (Azure AD) app registration
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=

# "Personal Microsoft accounts only" app registration.
# Must be this literal MSA consumer tenant GUID, NOT the "consumers" alias --
# Microsoft's discovery doc for /consumers/v2.0 returns this GUID as its issuer,
# and Auth.js requires an exact match.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/9188040d-6c67-4c5b-b112-36a304b66dad/v2.0

# Azure AI Foundry project endpoint (Foundry portal -> your project -> Overview).
# Looks like: https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_FOUNDRY_PROJECT_ENDPOINT=

# Auth uses DefaultAzureCredential.
# Locally: leave the three vars below empty and run `az login` (Azure CLI) instead.
# On Vercel/production (no Azure CLI, no managed identity available): create an
# Entra "App registration" with a client secret, grant it access to the Foundry
# project, and set these three so EnvironmentCredential picks them up:
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
